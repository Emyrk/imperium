{
  "name": "imperium",
  "version": "0.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "lint": "eslint . --ext .js,.ts",
    "lint-stats": "eslint . --ext .js,.ts --format \"node_modules/eslint-stats/byErrorAndWarning.js\"",
    "build": "rollup -c",
    "push-main": "rollup -c --environment DEST:main",
    "push-pserver": "rollup -c --environment DEST:pserver",
    "push-sim": "rollup -c --environment DEST:sim",
    "push-noobie": "rollup -c --environment DEST:noobie",
    "test": "vitest",
    "test-watch": "vitest --watch",
    "test-cov": "vitest --coverage",
    "test-only": "bash -c 'jest --watch --coverage --verbose --collectCoverageFrom=\"**/*$1*\" $1' -- ",
    "watch-main": "rollup -cw --environment DEST:main",
    "watch-pserver": "rollup -cw --environment DEST:pserver",
    "watch-sim": "rollup -cw --environment DEST:sim"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/screepers/screeps-typescript-starter.git"
  },
  "author": "",
  "license": "Unlicense",
  "bugs": {
    "url": "https://github.com/screepers/screeps-typescript-starter/issues"
  },
  "homepage": "https://github.com/screepers/screeps-typescript-starter#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^20.0.0",
    "@rollup/plugin-node-resolve": "^13.0.4",
    "@rollup/plugin-replace": "^5.0.5",
    "@types/jest": "^27.0.1",
    "@types/lodash": "3.10.2",
    "@types/node": "^10.5.5",
    "@types/screeps": "^3.2.3",
    "@typescript-eslint/eslint-plugin": "^4.31.0",
    "@typescript-eslint/parser": "^4.31.0",
    "@vitest/coverage-v8": "^1.5.0",
    "eslint": "^7.32.0",
    "eslint-plugin-import": "^2.24.2",
    "eslint-plugin-unused-imports": "^3.1.0",
    "eslint-stats": "^1.0.1",
    "lodash": "^3.10.1",
    "rollup": "^2.56.2",
    "rollup-plugin-clear": "^2.0.7",
    "rollup-plugin-screeps": "^1.0.1",
    "rollup-plugin-typescript2": "^0.31.0",
    "screeps-jest": "^2.0.2",
    "ts-jest": "^27.1.5",
    "ts-node": "^7.0.1",
    "tslib": "^2.6.2",
    "tsx": "^4.7.3",
    "typescript": "^4.2.3",
    "vitest": "^1.5.0"
  },
  "dependencies": {
    "@screeps/engine": "^4.2.22",
    "@types/pathfinding": "^0.0.9",
    "cloc": "2.0.0-cloc",
    "emyrk-screeps-cartographer": "^1.9.0",
    "kruskal-mst": "^1.0.0",
    "pathfinding": "github:jbrown123/PathFinding.js",
    "source-map": "~0.6.1",
    "ts-md5": "^1.3.1",
    "vite-tsconfig-paths": "^4.3.2"
  }
}
